# 보안 파일
config/secrets.yaml
credentials.json

# 가상환경 / 캐시 / 생성물 (대용량)
.venv/
__pycache__/
*.pyc
data/cache/
data/outputs/
*.db
data/logs/*.log

# 런타임 데이터(코드 아님 — 실행 중 생성/갱신). 코드/데이터 분리.
# (주의: .gitignore는 인라인 주석 미지원 — 패턴만 단독 라인으로)
data/logs/*.json
data/schedule/
data/legal/
data/workspace/*
!data/workspace/_site/

# Security / secrets
.env
.env.*
*.secret
*secret*
*credential*
*credentials*
*token*
*api_key*
/frontend/node_modules/
